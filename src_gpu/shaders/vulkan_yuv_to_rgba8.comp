#include "compute_root.h"
[[vk::push_constant]] ConstantBuffer<ComputeRoot> root;

uint packRgba8(float4 value) {
    uint4 packed = uint4(round(saturate(value) * 255.0));
    return packed.x | (packed.y << 8) | (packed.z << 16) | (packed.w << 24);
}
[numthreads(16, 16, 1)]
void computeMain(uint3 dispatchID : SV_DispatchThreadID,
                 uint3 groupThreadID : SV_GroupThreadID,
                 uint groupIndex : SV_GroupIndex,
                 uint3 groupID : SV_GroupID) {
    Texture2D<float4> y_plane = ResourceDescriptorHeap[root.yIndex];
    Texture2D<float4> uv_plane = ResourceDescriptorHeap[root.uvIndex];
    SamplerState y_sampler = SamplerDescriptorHeap[0];
    SamplerState uv_sampler = SamplerDescriptorHeap[1];
    uint y_width, y_height, uv_width, uv_height;
    y_plane.GetDimensions(y_width, y_height);
    uv_plane.GetDimensions(uv_width, uv_height);
    uint3 gid = dispatchID;
    if (gid.x >= root.params[0] || gid.y >= root.params[1]) {
        return;
    }

    float2 position = (float2(gid.xy) + float2(0.5)) /
                    float2(uint2(y_width, y_height));
    float y = y_plane.SampleLevel(y_sampler, position, 0).r;
    float2 uv_position = position;
    int2 uv_extent = uint2(uv_width, uv_height);
    uv_position.x = (floor(position.x * float(uv_extent.x)) + 0.5) /
                    float(uv_extent.x);
    uv_position.y = (floor(position.y * float(uv_extent.y)) + 0.5) /
                    float(uv_extent.y);
    float2 uv = uv_plane.SampleLevel(uv_sampler, uv_position, 0).rg;

    float max_code = float((1u << root.params[2]) - 1u);
    if (root.params[3] == 0u) {
        y = (y - 16.0 / max_code) * (max_code / 219.0);
        uv = (uv - float2(128.0 / max_code)) * (max_code / 224.0);
    } else {
        uv -= float2(0.5);
    }

    // Both benchmark files are BT.709 limited-range video. The matrix is
    // kept in the shader so the decoded image never visits CPU memory.
    float3 rgb = float3(
        y + 1.5748 * uv.y,
        y - 0.187324 * uv.x - 0.468124 * uv.y,
        y + 1.8556 * uv.x);
    rgb = clamp(rgb, 0.0, 1.0);
    ((uint*)root.buffers[2])[gid.y * root.params[0] + gid.x] = packRgba8(float4(rgb, 1.0));
}
