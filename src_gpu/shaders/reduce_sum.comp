#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputValues {
    float values[];
} inputValues;

layout(set = 0, binding = 1, std430) writeonly buffer OutputSums {
    float sums[];
} outputSums;

layout(push_constant) uniform Params {
    uint len;
    uint width;
    uint height;
    uint level;
} params;

shared float partialSums[256];

void main() {
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    const uint localIndex = gl_LocalInvocationIndex;
    float value = 0.0;
    if (pixel.x < params.width && pixel.y < params.height) {
        value = inputValues.values[pixel.y * params.width + pixel.x];
    }
    partialSums[localIndex] = value;
    barrier();

    for (uint stride = 128; stride > 0; stride >>= 1) {
        if (localIndex < stride) {
            partialSums[localIndex] += partialSums[localIndex + stride];
        }
        barrier();
    }

    if (localIndex == 0) {
        const uint outputIndex =
            gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
        outputSums.sums[outputIndex] = partialSums[0];
    }
}
