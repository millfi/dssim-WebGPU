#include "compute_root.h"
[[vk::push_constant]] ConstantBuffer<ComputeRoot> root;

groupshared float partialSums[256];

[numthreads(16, 16, 1)]
void computeMain(uint3 dispatchID : SV_DispatchThreadID,
                 uint3 groupThreadID : SV_GroupThreadID,
                 uint groupIndex : SV_GroupIndex,
                 uint3 groupID : SV_GroupID) {
    const uint2 pixel = dispatchID.xy;
    const uint localIndex = groupIndex;
    float value = 0.0;
    if (pixel.x < root.params[1] && pixel.y < root.params[2]) {
        value = ((float*)root.buffers[0])[pixel.y * root.params[1] + pixel.x];
    }
    partialSums[localIndex] = value;
    GroupMemoryBarrierWithGroupSync();

    for (uint stride = 128; stride > 0; stride >>= 1) {
        if (localIndex < stride) {
            partialSums[localIndex] += partialSums[localIndex + stride];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (localIndex == 0) {
        const uint outputIndex =
            groupID.y * ((root.params[1] + 15u) / 16u) + groupID.x;
        ((float*)root.buffers[1])[outputIndex] = partialSums[0];
    }
}
