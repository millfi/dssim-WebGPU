#include "compute_root.h"
[[vk::push_constant]] ConstantBuffer<ComputeRoot> root;

static const float gaussian_weights[25] = {
    0.009088, 0.022516, 0.032123, 0.022516, 0.009088,
    0.022516, 0.055786, 0.079586, 0.055786, 0.022516,
    0.032123, 0.079586, 0.113540, 0.079586, 0.032123,
    0.022516, 0.055786, 0.079586, 0.055786, 0.022516,
    0.009088, 0.022516, 0.032123, 0.022516, 0.009088
};

[numthreads(16, 16, 1)]
void computeMain(uint3 dispatchID : SV_DispatchThreadID,
                 uint3 groupThreadID : SV_GroupThreadID,
                 uint groupIndex : SV_GroupIndex,
                 uint3 groupID : SV_GroupID) {
    uint3 gid = dispatchID;
    if (gid.x >= root.params[1] || gid.y >= root.params[2]) {
        return;
    }

    uint i = gid.y * root.params[1] + gid.x;
    int x = int(gid.x);
    int y = int(gid.y);
    int max_x = int(root.params[1]) - 1;
    int max_y = int(root.params[2]) - 1;

    float3 sum1 = float3(0.0, 0.0, 0.0);
    float3 sum2 = float3(0.0, 0.0, 0.0);
    float3 sumsq1 = float3(0.0, 0.0, 0.0);
    float3 sumsq2 = float3(0.0, 0.0, 0.0);
    float3 sum12 = float3(0.0, 0.0, 0.0);

    for (int dy = -2; dy <= 2; dy = dy + 1) {
        for (int dx = -2; dx <= 2; dx = dx + 1) {
            int nx = clamp(x + dx, 0, max_x);
            int ny = clamp(y + dy, 0, max_y);
            uint ni = uint(ny) * root.params[1] + uint(nx);
            float w = gaussian_weights[(dy + 2) * 5 + dx + 2];

            float3 lab1 = ((float4*)root.buffers[0])[ni].xyz;
            float3 lab2 = ((float4*)root.buffers[1])[ni].xyz;

            sum1 = sum1 + w * lab1;
            sum2 = sum2 + w * lab2;
            sumsq1 = sumsq1 + w * lab1 * lab1;
            sumsq2 = sumsq2 + w * lab2 * lab2;
            sum12 = sum12 + w * lab1 * lab2;
        }
    }

    float3 mu1 = sum1;
    float3 mu2 = sum2;
    float3 var1 = sumsq1 - mu1 * mu1;
    float3 var2 = sumsq2 - mu2 * mu2;
    float3 cov12 = sum12 - mu1 * mu2;

    float mu1_sq = (mu1.x * mu1.x + mu1.y * mu1.y + mu1.z * mu1.z) / 3.0;
    float mu2_sq = (mu2.x * mu2.x + mu2.y * mu2.y + mu2.z * mu2.z) / 3.0;
    float sigma1_sq = (var1.x + var1.y + var1.z) / 3.0;
    float sigma2_sq = (var2.x + var2.y + var2.z) / 3.0;

    float3 mean_delta = mu1 - mu2;
    float mean_delta_sq =
        (mean_delta.x * mean_delta.x +
         mean_delta.y * mean_delta.y +
         mean_delta.z * mean_delta.z) / 3.0;
    float3 delta_second_moment_components =
        (sumsq1 - sum12) + (sumsq2 - sum12);
    float delta_second_moment =
        (delta_second_moment_components.x +
         delta_second_moment_components.y +
         delta_second_moment_components.z) / 3.0;
    float delta_variance = delta_second_moment - mean_delta_sq;

    float c1 = 0.01 * 0.01;
    float c2 = 0.03 * 0.03;
    float luminance_denom = mu1_sq + mu2_sq + c1;
    float variance_denom = sigma1_sq + sigma2_sq + c2;
    float loss_numer =
        mean_delta_sq * variance_denom +
        delta_variance * luminance_denom -
        mean_delta_sq * delta_variance;
    float denom = luminance_denom * variance_denom;
    float ssim = 1.0 - loss_numer / denom;

    ((float*)root.buffers[2])[i] = ssim;
    ((float*)root.buffers[3])[i] = mu1.x;
    ((float*)root.buffers[4])[i] = mu2.x;
    ((float*)root.buffers[5])[i] = var1.x;
    ((float*)root.buffers[6])[i] = var2.x;
    ((float*)root.buffers[7])[i] = cov12.x;
}
