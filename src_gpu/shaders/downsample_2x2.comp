#include "compute_root.h"
[[vk::push_constant]] ConstantBuffer<ComputeRoot> root;

[numthreads(16, 16, 1)]
void computeMain(uint3 dispatchID : SV_DispatchThreadID,
                 uint3 groupThreadID : SV_GroupThreadID,
                 uint groupIndex : SV_GroupIndex,
                 uint3 groupID : SV_GroupID) {
    uint3 gid = dispatchID;
    if (gid.x >= root.params[2] || gid.y >= root.params[3]) {
        return;
    }

    uint i = gid.y * root.params[2] + gid.x;
    uint ox = gid.x;
    uint oy = gid.y;
    int sx0 = int(ox * 2u);
    int sy0 = int(oy * 2u);
    int max_x = int(root.params[0]) - 1;
    int max_y = int(root.params[1]) - 1;

    float4 sum = float4(0.0, 0.0, 0.0, 0.0);

    for (int dy = 0; dy < 2; dy = dy + 1) {
        for (int dx = 0; dx < 2; dx = dx + 1) {
            uint sx = uint(clamp(sx0 + dx, 0, max_x));
            uint sy = uint(clamp(sy0 + dy, 0, max_y));
            uint si = sy * root.params[0] + sx;
            sum = sum + ((float4*)root.buffers[0])[si];
        }
    }

    ((float4*)root.buffers[1])[i] = sum * 0.25;
}
